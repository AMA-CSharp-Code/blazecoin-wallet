<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: Windows desktop wallet, self-contained, unpackaged.

  Usage:
    dotnet publish -f net10.0-windows10.0.19041.0 -c Release -p:PublishProfile=win-x64

  Output: bin\Release\net10.0-windows10.0.19041.0\win-x64\publish\ (~350 MB,
  CoreCLR + WindowsAppRuntime included; needs only the WebView2 runtime on the
  target machine).

  Why RuntimeIdentifierOverride instead of plain `-r win-x64`: `dotnet publish -r`
  injects the RID into RESTORE for every TargetFramework of this multi-targeted
  project, and the Mono-based Android/iOS TFMs then demand a nonexistent
  Microsoft.NETCore.App.Runtime.Mono.win-x64 runtime pack (NU1102) — even when
  `-f` selects only the Windows TFM, because restore is project-wide. The
  WindowsAppSDK targets consume RuntimeIdentifierOverride AFTER restore and apply
  the RID to the Windows TFM only. (ROADMAP §A packaging blocker, solved 2026-07-06.)
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
