@* Left-hand wallet navigation, styled after the V1.5 Qt wallet's toolbar:
   a vertical stack of full-width crimson "bars". *@
<nav class="wallet-sidebar">
    <NavLink class="side-bar" href="" Match="NavLinkMatch.All">
        @* dashboard panel layout: tall left panel + two stacked right panels; currentColor → theme red *@
        <svg class="side-ico side-ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="5" width="6" height="14" rx="1.2" />
            <rect x="12" y="5" width="8" height="6" rx="1.2" />
            <rect x="12" y="13" width="8" height="6" rx="1.2" />
        </svg><span class="side-label">Dashboard</span>
    </NavLink>
    <NavLink class="side-bar" href="send">
        @* thick filled triangle pointing right — matches V1.5's send block-arrow *@
        <span class="side-ico">▶</span><span class="side-label">Send Coins</span>
    </NavLink>
    <NavLink class="side-bar" href="receive">
        @* thick filled triangle pointing left *@
        <span class="side-ico">◀</span><span class="side-label">Receive Coins</span>
    </NavLink>
    <NavLink class="side-bar" href="transactions">
        @* a tight up/down pair of filled triangles — bidirectional in/out flow *@
        <span class="side-ico side-ico-tx"><span>▲</span><span>▼</span></span><span class="side-label">Transactions</span>
    </NavLink>
    <NavLink class="side-bar" href="addressbook">
        @* open-book icon echoing V1.5's address book; currentColor → theme red *@
        <svg class="side-ico side-ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6C9.8 4.4 6.3 4.1 3.8 4.7v12.6c2.5-0.6 6-0.3 8.2 1.3 2.2-1.6 5.7-1.9 8.2-1.3V4.7C17.7 4.1 14.2 4.4 12 6z" />
            <path d="M12 6v12.6" />
        </svg><span class="side-label">Address Book</span>
    </NavLink>
    <NavLink class="side-bar" href="mining">
        <span class="side-ico">⛏</span><span class="side-label">Mining</span>
    </NavLink>
    <NavLink class="side-bar" href="provenance">
        @* a coin with an age-ring — the mint-ancestry page; currentColor → theme red *@
        <svg class="side-ico side-ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.5" />
            <circle cx="12" cy="12" r="4" />
            <path d="M12 3.5v2M12 18.5v2M3.5 12h2M18.5 12h2" />
        </svg><span class="side-label">Provenance</span>
    </NavLink>
    <NavLink class="side-bar" href="quantum">
        @* a key inside a shield — which keys the chain has already seen; currentColor → theme red *@
        <svg class="side-ico side-ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6L12 3z" />
            <circle cx="10.5" cy="11" r="2" />
            <path d="M12 12.5 15.5 16M14 14.5l1 1" />
        </svg><span class="side-label">Quantum</span>
    </NavLink>
    <NavLink class="side-bar" href="console">
        @* PC-screen / monitor with a >_ prompt; currentColor → theme red *@
        <svg class="side-ico side-ico-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="4" width="19" height="13" rx="1.5" />
            <path d="M9 21h6" />
            <path d="M12 17v4" />
            <path d="M6.5 8.5 9.5 11l-3 2.5" />
            <path d="M11.5 13.5H15.5" />
        </svg><span class="side-label">Console</span>
    </NavLink>
</nav>
