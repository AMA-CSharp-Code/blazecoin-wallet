{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5210"
      }
    }
  },
  "Daemon": {
    "Url": "http://127.0.0.1:55413/",
    "CookiePath": "/var/lib/blazecoin/.cookie"
  },
  "Index": {
    "DbPath": "data/lite-index.db",
    "PollSeconds": 5,
    "StartHeight": 0
  },
  "Broadcast": {
    "PerMinute": 6
  }
}
