<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- iOS ONLY, deliberately: single-TFM mirrors the Droid head's decision — a
             multi-TFM head reintroduces the NU1102 Mono-runtime-pack publish trap the
             desktop app hit (see ROADMAP §A). One head project per platform. -->
        <TargetFrameworks>net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>BlazecoinWallet.App.iOS</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- XAML source generation, same as the Droid head. -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name (home-screen label — kept short so it never truncates) -->
        <ApplicationTitle>Blazecoin</ApplicationTitle>

        <!-- App Identifier — same bundle id family as the Droid head. -->
        <ApplicationId>com.blazecoin.wallet</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon: the classic 2014 gold-coin phoenix (V1.5 splash art) — same source
             assets as the Droid head; resizetizer emits the iOS asset catalog from them. -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" />

        <!-- Splash Screen: BLAZECOIN / MOBILE lockup (white on crimson). As on Android,
             the platform launch screen is only a brief flash — the big branding moment
             is the WebView #app-splash overlay in wwwroot/index.html. -->
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#9E000F" BaseSize="288,288" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlazecoinWallet.Lite.Core\BlazecoinWallet.Lite.Core.csproj" />
        <ProjectReference Include="..\BlazecoinWallet.Lite.UI\BlazecoinWallet.Lite.UI.csproj" />
    </ItemGroup>

</Project>
