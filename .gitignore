# Android release signing - the upload keystore + its password config live OUTSIDE
# the repo (C:\Users\<you>\BlazecoinSigning\); these rules are a safety net so a
# stray copy can never be committed.
*.keystore
*.jks
signing.json
BlazecoinWallet.App.Droid/artifacts/
bin-test/
