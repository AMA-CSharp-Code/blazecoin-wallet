<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) backup/transfer rules: exclude EVERYTHING from cloud backup and
     device-to-device transfer. The wallet's only sensitive artifact is the seed, and it
     must not leave the device by any automated channel — the mnemonic paper backup is the
     sole recovery path by design. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
