@implements IDisposable
@inject IScreenCaptureGuard Guard

@* Put this on every page that shows or takes a recovery phrase or a private key. While the page
   is on screen the window is kept out of screenshots, screen recording, casting and the
   recent-apps thumbnail (Android's secure-window flag); it is released when the page goes away.
   Bug-bounty report 2026-11-09: the backup page printed all twelve words in an unprotected
   window. A test (SecretScreenTests) fails if a page that handles a secret leaves this out. *@

@code {
    private IDisposable? _hold;

    protected override void OnInitialized() => _hold = Guard.Protect();

    public void Dispose() => _hold?.Dispose();
}
