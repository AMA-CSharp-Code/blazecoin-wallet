{
  // Machine-independent defaults — this file is EMBEDDED in the app and ships to
  // every install, so it must never contain machine paths or credentials.
  //
  //   RpcUrl      : Blazecoin mainnet RPC (55413) on loopback.
  //   RpcUser/Pass: EMPTY → the wallet reads the daemon's auto-generated .cookie
  //                 from the datadir (fresh random secret per daemon start).
  //   ExePath     : EMPTY → the wallet launches blazecoind.exe found next to the
  //                 app exe (where the installer ships it).
  //   DataDir     : EMPTY → mirror of blazecoind's own default (legacy
  //                 %APPDATA%\BlazecoinV2.0 if it exists, else %LOCALAPPDATA%\BlazecoinV2.0).
  //
  // Dev overrides go on the command line (--rpcuser/--rpcpass/--datadir/--exepath,
  // see Launch-BlazecoinV2-Wallets.ps1) — NOT in this file.
  "Blazecoind": {
    "RpcUrl": "http://127.0.0.1:55413",
    "RpcUser": "",
    "RpcPassword": "",
    "ExePath": "",
    "DataDir": ""
  }
}
