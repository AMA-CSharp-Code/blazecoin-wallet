<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet run (project BlazecoinWallet.PqBench.Runner, configuration Release, optional argument
       "quick") prints the two Markdown tables for PQ_SIGNATURES.md. Release matters: Debug timings
       are meaningless. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);SYSLIB5006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazecoinWallet.PqBench\BlazecoinWallet.PqBench.csproj" />
  </ItemGroup>

</Project>
